# GenerateRoute.srv — 병합 지도 + 마커 map 좌표 → 로봇별 순찰 웨이포인트
# 서비스명: /patrol/generate_route   (SDD 4.2.2 — 필드는 SDD에 정의 없음, REP-02 신규 설계)
# 서버: patrol_planner(NAV-03, R2)   클라이언트: mission_manager PLAN 상태(MIS-03, R3)
# 관련 완료 기준: NAV-03 "랙 4기→pose 4개, 배정 규칙, yaml 저장"

string robot_id                     # 경로를 요청하는 로봇
string[] fleet_robot_ids            # 분담 대상 전체. 통로 홀/짝 배정 계산용. 단독이면 [robot_id]
bool force_regenerate               # true=캐시된 patrol_routes.yaml 무시하고 재계산
---
bool success
geometry_msgs/PoseStamped[] waypoints  # frame_id="map". 랙 정면 0.6m 점검 pose, 방문 순서
string[] rack_ids                      # waypoints 와 같은 길이·같은 순서 (1:1 대응)
string[] zone_ids                      # waypoints 와 같은 길이·같은 순서
string message
