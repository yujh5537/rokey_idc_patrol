# DockOrder.srv — 도킹 순서 요청, 미허가 시 대기 pose 응답 (순차 도킹)
# 서비스명: /fleet/request_dock   (SDD 4.2.2 — 필드는 SDD에 정의 없음, REP-02 신규 설계)
# 서버: fleet_coordinator(MIS-04, R3)   클라이언트: mission_manager RETURN 상태(MIS-03/06, R3)
# 관련 완료 기준: MIS-04 "merge_done 브로드캐스트, DockOrder 응답" / MIS-06 "순차 도킹 3회"

string robot_id
float32 battery                     # 0.0~1.0. 낮은 쪽에 우선권
bool urgent                         # true = 배터리 25% 미만 강제 복귀
---
bool granted                        # true=즉시 도킹 진행, false=대기
uint8 queue_position                # granted=true면 0, 대기 중이면 1,2,...
geometry_msgs/PoseStamped wait_pose # granted=false일 때 이동할 대기 지점(frame_id="map")
float32 retry_after                 # 재요청 권장 대기 시간 [s]
string message
